# Public hostname Caddy serves (must resolve to the VPS IP), e.g. srv123456.hstgr.cloud
DOMAIN=polartrap.example.com
# Long random strings: python -c "import secrets;print(secrets.token_hex(32))"
ANON_HMAC_KEY=change-me
ADMIN_PASSWORD=change-me
# Hostinger AI Router (OpenAI-compatible) - used from M2
AI_ROUTER_API_KEY=
AI_ROUTER_BASE_URL=
AI_MODEL_CHEAP=
AI_MODEL_STRONG=
# Set to 0 only for plain-http local dev on a non-localhost host
COOKIE_SECURE=1
